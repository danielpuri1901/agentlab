# ARM64 (Graviton) worker image for AgentLab's explain track: same worker
# entrypoint as Dockerfile, plus the render toolchain (ffmpeg, Manim's
# system-library dependencies, Amazon Polly narration via the `video` uv
# dependency group) that only the explain task definition (infra/ecs.tf)
# needs. Built and pushed by GitHub Actions
# (.github/workflows/build-images.yml), tagged "video-<git-sha>" in the
# same ECR repo as the main image - never :latest, never the main image's
# tag, so a plain `terraform apply` cannot accidentally cross-wire the two.
#
# uv-in-Docker pattern verified against
# https://docs.astral.sh/uv/guides/integration/docker/ on 2026-08-16 (same
# citation as Dockerfile): copy the pinned uv binary from Astral's
# distroless image, sync dependencies before copying source (intermediate
# layer caching), then sync the full project. uv version pinned to 0.10.9,
# matching Dockerfile, for the same "pin to a specific uv version" reason.
#
# Deviations from Dockerfile, and why:
#   - `uv sync` here always adds `--group video` (manim, mutagen -
#     pyproject.toml's new [dependency-groups].video), on top of the same
#     --frozen/--no-dev discipline as the main image. That group is
#     deliberately absent from Dockerfile's own `uv sync` calls: the
#     arm-runner/finalizer/proposer tasks never render a video, so they
#     have no business pulling in Manim's dependency footprint (numpy,
#     scipy, pycairo, pydub, ...). Syncing it here pre-warms uv's shared
#     wheel cache (content-addressed, shared between `uv sync` and `uvx`)
#     so the render path's `uvx --python 3.12 manim ...` subprocess call
#     (src/agentlab/video_render.py's render_scene_video - manim runs in
#     its own uv-tool-managed environment, never imported into agentlab's
#     own venv, hence video_scenes.py's "this module never imports manim"
#     docstring) resolves from cache instead of hitting the network at
#     render time, which is what keeps a render under the spec's ~10-minute
#     budget.
#   - apt packages added: `ffmpeg` (video_render.py's ffprobe/ffmpeg
#     subprocess calls - narration concat, final mux); `libcairo2-dev`,
#     `libpango1.0-dev`, `pkg-config` (build-time: what pycairo/pangocairo,
#     Manim's text-rendering dependencies, need to build on this
#     platform); `fonts-dejavu` (runtime: a font family the container can
#     fall back to when Manim renders text - the base python:3.12-slim
#     image ships no fonts at all); `fonts-noto-color-emoji` (runtime: the
#     diagram nodes' emoji icons, video_scenes.py's `_make_icon` -
#     verified locally on macOS that this Pango/cairo stack silently
#     drops an emoji glyph rather than raising, see that function's
#     docstring, so this package gives the deployed render its one real
#     shot at the glyph; `_make_icon`'s plain-dot fallback still covers
#     every environment where it doesn't take).
#   - TeX Live and the CMU fonts come from the `tex` stage below: LaTeX
#     for MathTex, axis numbers, and matrices, and CMU Serif for
#     3Blue1Brown's text font (docs/superpowers/specs/
#     2026-10-05-3b1b-style-videos-design.md). `fontconfig` registers the
#     fonts so Pango finds "CMU Serif".
#   - `final` also carries the `uv`/`uvx` binary forward (Dockerfile's
#     `final` does not, since the main image's commands never shell out to
#     `uvx`) so the render path's subprocess call resolves at runtime.
#
# Stage layout mirrors Dockerfile exactly (base/deps/builder/test/final);
# `final` still forces the `test` stage (and its `uv run pytest -q`) to run
# as part of `docker build`, same gate as the main image.

# TeX Live, installed the way Manim's own image does it (ManimCommunity/manim
# docker/Dockerfile, read 2026-10-05): the minimal scheme plus the package
# list from Manim's installation docs (v0.21.0) without ctex, plus
# cm-unicode for 3Blue1Brown's CMU Serif text font.
FROM python:3.12-slim AS tex
# libfontconfig1: tlmgr builds the XeTeX formats, and the xetex binary needs
# it (Manim's builder stage gets it through Pango). gnupg: tlmgr verifies
# package signatures with it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        libfontconfig1 \
        perl \
        wget \
    && rm -rf /var/lib/apt/lists/*
COPY docker/texlive-profile.txt /tmp/texlive-profile.txt
ENV PATH="/usr/local/texlive/bin/aarch64-linux:/usr/local/texlive/bin/x86_64-linux:$PATH"
# mirror.ctan.org sends each request to some mirror, and one bad mirror failed
# a pull request build on 2026-10-06. Retry the whole install up to three
# times; each try starts clean and gets a mirror again.
RUN for attempt in 1 2 3; do \
        rm -rf /tmp/install-tl /tmp/install-tl-unx.tar.gz /usr/local/texlive \
        && wget -nv -O /tmp/install-tl-unx.tar.gz https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz \
        && mkdir /tmp/install-tl \
        && tar -xzf /tmp/install-tl-unx.tar.gz -C /tmp/install-tl --strip-components=1 \
        && /tmp/install-tl/install-tl --profile=/tmp/texlive-profile.txt \
        && tlmgr install \
            amsmath babel-english cbfonts-fd cm-super count1to doublestroke dvisvgm \
            everysel fontspec frcursive fundus-calligra gnu-freefont jknapltx latex-bin \
            mathastext microtype multitoc physics prelim2e preview ragged2e relsize rsfs \
            setspace standalone tipa wasy wasysym xcolor xetex xkeyval \
            cm-unicode \
        && break; \
        if [ "$attempt" = 3 ]; then exit 1; fi; \
        echo "TeX Live install failed on try $attempt, retrying"; \
        sleep 20; \
    done \
    && rm -rf /tmp/install-tl /tmp/install-tl-unx.tar.gz

FROM python:3.12-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libcairo2-dev \
        libpango1.0-dev \
        pkg-config \
        fonts-dejavu \
        fonts-noto-color-emoji \
        fontconfig \
        build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tex /usr/local/texlive /usr/local/texlive
ENV PATH="/usr/local/texlive/bin/aarch64-linux:/usr/local/texlive/bin/x86_64-linux:$PATH"
RUN ln -s /usr/local/texlive/texmf-dist/fonts/opentype/public/cm-unicode /usr/share/fonts/cm-unicode \
    && fc-cache -f
WORKDIR /app

FROM base AS deps
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group video --no-install-project

FROM deps AS builder
COPY . .
RUN uv sync --frozen --no-dev --group video

FROM builder AS test
RUN uv sync --frozen --group video
RUN uv run pytest -q
# The render tests prove TeX, the CMU font, and the example scene work in
# this image. The default run above excludes them (pyproject addopts).
RUN uv run pytest -q -m render tests/test_story_scene.py

FROM python:3.12-slim AS final
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libcairo2-dev \
        libpango1.0-dev \
        pkg-config \
        fonts-dejavu \
        fonts-noto-color-emoji \
        fontconfig \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tex /usr/local/texlive /usr/local/texlive
ENV PATH="/usr/local/texlive/bin/aarch64-linux:/usr/local/texlive/bin/x86_64-linux:$PATH"
RUN ln -s /usr/local/texlive/texmf-dist/fonts/opentype/public/cm-unicode /usr/share/fonts/cm-unicode \
    && fc-cache -f
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
RUN groupadd --system --gid 999 agentlab \
    && useradd --system --gid 999 --uid 999 --create-home agentlab
WORKDIR /app
COPY --from=builder --chown=agentlab:agentlab /app /app
# Dependency edge only: forces the `test` stage (and its `uv run pytest -q`)
# to run as part of this build. The copied file is never read at runtime.
COPY --from=test /app/pyproject.toml /tmp/.pytest-gate
ENV PATH="/app/.venv/bin:$PATH"
USER agentlab
ENTRYPOINT ["agentlab"]
