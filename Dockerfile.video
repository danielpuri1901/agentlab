# ARM64 (Graviton) worker image for AgentLab's explain track: same worker
# entrypoint as Dockerfile, plus the render toolchain (ffmpeg, Manim's
# system-library dependencies, Amazon Polly narration via the `video` uv
# dependency group) that only the explain task definition (infra/ecs.tf)
# needs. Built and pushed separately by
# scripts/build_and_push_video_image.sh, tagged "<git-sha>-video" in the
# same ECR repo as the main image - never :latest, never the main image's
# tag, so a plain `terraform apply` cannot accidentally cross-wire the two.
#
# uv-in-Docker pattern verified against
# https://docs.astral.sh/uv/guides/integration/docker/ on 2026-08-16 (same
# citation as Dockerfile): copy the pinned uv binary from Astral's
# distroless image, sync dependencies before copying source (intermediate
# layer caching), then sync the full project. uv version pinned to 0.10.9,
# matching Dockerfile, for the same "pin to a specific uv version" reason.
#
# Deviations from Dockerfile, and why:
#   - `uv sync` here always adds `--group video` (manim, mutagen -
#     pyproject.toml's new [dependency-groups].video), on top of the same
#     --frozen/--no-dev discipline as the main image. That group is
#     deliberately absent from Dockerfile's own `uv sync` calls: the
#     arm-runner/finalizer/proposer tasks never render a video, so they
#     have no business pulling in Manim's dependency footprint (numpy,
#     scipy, pycairo, pydub, ...). Syncing it here pre-warms uv's shared
#     wheel cache (content-addressed, shared between `uv sync` and `uvx`)
#     so the render path's `uvx --python 3.12 manim ...` subprocess call
#     (src/agentlab/video_render.py's render_scene_video - manim runs in
#     its own uv-tool-managed environment, never imported into agentlab's
#     own venv, hence video_scenes.py's "this module never imports manim"
#     docstring) resolves from cache instead of hitting the network at
#     render time, which is what keeps a render under the spec's ~10-minute
#     budget.
#   - apt packages added: `ffmpeg` (video_render.py's ffprobe/ffmpeg
#     subprocess calls - narration concat, final mux); `libcairo2-dev`,
#     `libpango1.0-dev`, `pkg-config` (build-time: what pycairo/pangocairo,
#     Manim's text-rendering dependencies, need to build on this
#     platform); `fonts-dejavu` (runtime: a font family the container can
#     fall back to when Manim renders text - the base python:3.12-slim
#     image ships no fonts at all).
#   - `final` also carries the `uv`/`uvx` binary forward (Dockerfile's
#     `final` does not, since the main image's commands never shell out to
#     `uvx`) so the render path's subprocess call resolves at runtime.
#
# Stage layout mirrors Dockerfile exactly (base/deps/builder/test/final);
# `final` still forces the `test` stage (and its `uv run pytest -q`) to run
# as part of `docker build`, same gate as the main image.

FROM python:3.12-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libcairo2-dev \
        libpango1.0-dev \
        pkg-config \
        fonts-dejavu \
        build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS deps
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group video --no-install-project

FROM deps AS builder
COPY . .
RUN uv sync --frozen --no-dev --group video

FROM builder AS test
RUN uv sync --frozen --group video
RUN uv run pytest -q

FROM python:3.12-slim AS final
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libcairo2-dev \
        libpango1.0-dev \
        pkg-config \
        fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
RUN groupadd --system --gid 999 agentlab \
    && useradd --system --gid 999 --uid 999 --create-home agentlab
WORKDIR /app
COPY --from=builder --chown=agentlab:agentlab /app /app
# Dependency edge only: forces the `test` stage (and its `uv run pytest -q`)
# to run as part of this build. The copied file is never read at runtime.
COPY --from=test /app/pyproject.toml /tmp/.pytest-gate
ENV PATH="/app/.venv/bin:$PATH"
USER agentlab
ENTRYPOINT ["agentlab"]
