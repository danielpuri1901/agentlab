# Local virtualenv - platform-specific, always rebuilt inside the image.
.venv/

# Local experiment output - never needed to build or test the worker image.
results/

# Planning artifacts - not part of the runtime or test surface.
.superpowers/

# docs/ is NOT excluded: worker.py's explain_command reads
# docs/classics.json and docs/interests.md at runtime inside the worker
# container (src/agentlab/worker.py's CLASSICS_PATH/INTERESTS_PATH, resolved
# relative to the repo root under /app).

# VCS metadata.
.git/
.gitignore

# Local run logs.
logs/

# Terraform local state/provider cache - not part of the container build.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# Python/tooling caches that should never be baked into a layer.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editor/OS cruft.
.DS_Store
media/
scripts/videos/media/
